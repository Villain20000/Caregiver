# ─────────────────────────────────────────────────────────────
# Dockerfile.web — Multi-stage build for the Angular SPA
#
# Build context is the repo root. Produces a static nginx-served
# production build of the Angular 17+ application.
#
# Two stages: build (Node + Angular CLI) → runtime (nginx Alpine).
# ─────────────────────────────────────────────────────────────

# Stage 1: Build the Angular application using Angular CLI.
# Copies package.json files, installs deps, then builds.
FROM node:20.11-alpine AS build
WORKDIR /app
COPY package.json package-lock.json* ./
# Copy workspace package.json files for npm workspaces resolution.
COPY apps/web/package.json ./apps/web/package.json
COPY packages/contracts/package.json ./packages/contracts/package.json
COPY packages/fhir-types/package.json ./packages/fhir-types/package.json
COPY packages/kafka/package.json ./packages/kafka/package.json
COPY packages/rbac/package.json ./packages/rbac/package.json
COPY packages/ui/package.json ./packages/ui/package.json
# Install the web workspace + shared deps.
RUN npm install --workspace @caregiver/web --include-workspace-root
# Copy TS config + source code.
COPY tsconfig.base.json ./
COPY apps/web ./apps/web
COPY packages ./packages
# Build the Angular app (outputs to apps/web/dist/caregiver-web).
RUN npm run build --workspace @caregiver/web

# Stage 2: Serve the static build with nginx.
# nginx config proxies /api and /socket.io to the API gateway container.
FROM nginx:1.27-alpine AS runtime
# Copy the Angular build output to nginx's serve directory.
COPY --from=build /app/apps/web/dist/caregiver-web /usr/share/nginx/html
# Custom nginx config with SPA fallback + API/Socket.io proxy.
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
