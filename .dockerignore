# .dockerignore — exclude files from the Docker build context.
#
# The Dockerfiles only COPY specific package.json / source / tsconfig files,
# so excluding these doesn't affect the build, but it dramatically speeds up
# the context upload to the Docker daemon and avoids cache-busting layers.

# Dependencies — installed inside the image via `npm install`.
**/node_modules

# Build output — regenerated inside the image.
**/dist
**/.angular
**/*.tsbuildinfo

# Version control & CI metadata.
.git
.github

# Test artifacts & coverage.
**/coverage
e2e

# Docs (not needed at runtime/build).
docs

# Env files (never bake secrets into images).
.env
.env.*
!.env.example

# Editor / OS cruft.
.vscode
.idea
.DS_Store
