# ─────────────────────────────────────────────────────────────
# Caregiver Healthcare Intelligence Platform — environment template
#
# Copy to .env (root) and to each workspace's local .env as needed.
# NEVER commit real secrets. All values below are local-dev defaults.
# In production, inject these via your orchestrator (k8s secrets, ECS,
# Vault, etc.) — never via a committed .env file.
# ─────────────────────────────────────────────────────────────

# ── Node / runtime ────────────────────────────────────────────
# Controls log verbosity across all services (pino/NestJS).
NODE_ENV=development
LOG_LEVEL=debug

# Per-service ports — each microservice binds its own port.
PORT_API=3000        # NestJS API gateway (REST + Socket.io)
PORT_WEB=4200        # Angular dev server
PORT_FHIR=4001       # fhir-ingestion microservice
PORT_AI=4002         # ai-rag microservice
PORT_NOTIF=4003      # notifications microservice
PORT_AUDIT=4004      # audit microservice

# ── Auth ──────────────────────────────────────────────────────
# JWT signing secret — MUST be ≥32 chars in production. Rotate regularly.
JWT_SECRET=change-me-in-prod-min-32-chars
JWT_EXPIRES_IN=15m           # Access token TTL
JWT_REFRESH_EXPIRES_IN=7d    # Refresh token TTL
CORS_ORIGIN=http://localhost:4200  # Allowed origin for browser requests

# ── PostgreSQL ────────────────────────────────────────────────
# Shared by apps/api and services that need direct DB access (fhir-ingestion,
# audit). Drizzle ORM connects via DATABASE_URL.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=caregiver
POSTGRES_USER=caregiver
POSTGRES_PASSWORD=caregiver_dev
# Drizzle connection string — consumed by packages/db
DATABASE_URL=postgresql://caregiver:caregiver_dev@localhost:5432/caregiver

# ── Kafka (event streaming) ───────────────────────────────────
# All microservices communicate via these topics. Each service has its own
# consumer group so it receives a full copy of relevant events.
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=caregiver
KAFKA_CONSUMER_GROUP_API=caregiver-api
KAFKA_CONSUMER_GROUP_FHIR=caregiver-fhir
KAFKA_CONSUMER_GROUP_AI=caregiver-ai
KAFKA_CONSUMER_GROUP_NOTIF=caregiver-notif
KAFKA_CONSUMER_GROUP_AUDIT=caregiver-audit

# ── ChromaDB (vector store for RAG) ───────────────────────────
# Used exclusively by services/ai-rag for embedding storage and retrieval.
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=caregiver_fhir

# ── Ollama (local LLM — Llama-3-8B) ───────────────────────────
# The ai-rag service sends prompts to Ollama and retrieves completions.
# OLLAMA_MODEL is the generation model; OLLAMA_EMBED_MODEL produces embeddings.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# ── FHIR ──────────────────────────────────────────────────────
# Base URL for external FHIR R4 server (for outbound queries if needed).
FHIR_R4_BASE=http://localhost:8080/fhir
# When true, fhir-ingestion rejects bundles that fail R4 schema validation.
FHIR_VALIDATION_STRICT=true

# ── Observability ─────────────────────────────────────────────
# OpenTelemetry OTLP exporter endpoint (Phase 3 — tracing/metrics).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
