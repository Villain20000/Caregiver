# .npmrc — npm configuration for the monorepo root.
#
# LangChain (@langchain/community) and ChromaDB ship loose peer-dependency
# ranges that conflict under npm's strict resolver (e.g. better-sqlite3
# version mismatches pulled transitively via typeorm). Rather than pinning
# every transitive dependency, we accept optional peer overrides globally.
#
# This is safe because:
#   1. We only use the modular @langchain/{core,community,ollama} packages,
#      not the umbrella `langchain` meta-package.
#   2. The conflicting peers (better-sqlite3, typeorm) are optional — we
#      don't use SQLite or TypeORM in any workspace.
legacy-peer-deps=true
