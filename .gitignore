# ─────────────────────────────────────────────────────────────
# .gitignore — Caregiver Healthcare Intelligence Platform monorepo
# Organized by category. All patterns apply recursively (** where noted).
# ─────────────────────────────────────────────────────────────

# ── Dependencies ──────────────────────────────────────────────
# node_modules exist at root and per-workspace (npm workspaces hoisting).
node_modules/
**/node_modules/

# ── Compiled output ───────────────────────────────────────────
# TypeScript build artifacts, Angular AOT output, general build dirs.
dist/
**/dist/
out-tsc/
build/
*.tsbuildinfo

# ── Angular cache ─────────────────────────────────────────────
# Angular CLI cache for builds and incremental compilation.
.angular/
.angular/cache/

# ── Testing artifacts ─────────────────────────────────────────
# Coverage reports (vitest/karma), Playwright output, test screenshots.
coverage/
playwright-report/
test-results/
.playwright/

# ── Build / bundler caches ────────────────────────────────────
# Turborepo, general cache dirs, ESLint cache file.
.turbo/
.cache/
.eslintcache

# ── System / IDE ──────────────────────────────────────────────
# IntelliJ, VS Code (preserve shared settings.json/launch.json), OS files.
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/*
.DS_Store
Thumbs.db

# ── Logs ──────────────────────────────────────────────────────
# All log files and npm/yarn/pnpm debug logs.
*.log
npm-debug.log*
yarn-error.log*
connect.lock
pnpm-debug.log*

# ── Local env files ───────────────────────────────────────────
# .env files contain secrets — NEVER commit them. Only .env.example is tracked.
.env
.env.local
.env.*.local
**/.env
**/.env.local

# ── Docker volumes (local dev persistence) ────────────────────
# Named Docker volumes mounted under docker/volumes/ for local dev.
docker/volumes/

# ── Drizzle ORM ───────────────────────────────────────────────
# Drizzle migration metadata — generated by drizzle-kit, not hand-edited.
drizzle/meta/
